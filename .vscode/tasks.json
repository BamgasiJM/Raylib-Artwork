{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build debug",
      "type": "process",
      "command": "make",
      "args": ["config=debug_x64", "-j8"],
      "options": { "cwd": "${workspaceFolder}" },
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1"]
      },
      "osx": { "args": ["config=debug_arm64", "-j8"] },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build release",
      "type": "process",
      "command": "make",
      "args": ["config=release_x64", "-j8"],
      "options": { "cwd": "${workspaceFolder}" },
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-Configuration", "Release"]
      },
      "osx": { "args": ["config=release_arm64", "-j8"] },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean",
      "type": "process",
      "command": "make",
      "args": ["clean"],
      "options": { "cwd": "${workspaceFolder}" },
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-Clean"]
      },
      "problemMatcher": []
    },
    {
      "label": "Generate compile_commands.json",
      "type": "process",
      "command": "make",
      "args": ["generate"],
      "options": { "cwd": "${workspaceFolder}" },
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-GenerateOnly"]
      },
      "osx": { "args": ["config=debug_arm64", "generate"] },
      "problemMatcher": []
    }
  ]
}
