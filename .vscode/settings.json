{
  "files.exclude": {
    "**/.git": true,
    "**/*.o": true,
    "**/*.exe": true
  },
  "search.exclude": {
    "build": true,
    "bin": true,
    "third_party": true,
    "tools/w64devkit": true
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/bin/**": true,
    "**/tools/w64devkit/**": true
  },
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  "terminal.integrated.env.windows": {
    "PATH": "${workspaceFolder}/tools/w64devkit/bin;${env:PATH}"
  }
}
